# ─── App URL ───────────────────────────────────────────────────────────────────
# Desarrollo: http://localhost:3000  |  Producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# ⚠️ NUNCA exponer con prefijo NEXT_PUBLIC_. Solo accesible en el servidor.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Personal Access Token para regenerar tipos TypeScript con: npm run db:types
# Obtener en: https://supabase.com/dashboard/account/tokens  (crea uno con nombre 'hce-local-dev')
# ⚠️ Solo necesario en desarrollo local. NO añadir en Vercel.
SUPABASE_ACCESS_TOKEN=sbp_<tu-personal-access-token>

# ─── Stripe ────────────────────────────────────────────────────────────────────
# Price ID del plan en Stripe Dashboard (empieza con price_...)
NEXT_PUBLIC_STRIPE_PRICE_ID=price_<your-price-id>
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_<your-publishable-key>

# ⚠️ Claves secretas de Stripe (Portal, webhooks y checkout)
STRIPE_SECRET_KEY=sk_test_<your-secret-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=<google-ai-studio-key>
GEMINI_MODEL=gemini-2.0-flash

# ─── Desarrollo y Tests E2E (Playwright) ───────────────────────────────────────
NEXT_ALLOWED_DEV_ORIGINS=
E2E_EMAIL=
E2E_PASSWORD=
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000

# Web Push Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
# ⚠️ Must be a valid mailto: URI (e.g. mailto:soporte@tu-dominio.com)
VAPID_MAILTO=mailto:soporte@tu-dominio.com

# ─── Admin Panel ───────────────────────────────────────────────────────────────
# Email address that has super-admin access to /admin panel.
# ⚠️ NUNCA exponer en el cliente. Solo accesible en el servidor.
ADMIN_EMAIL=tu-email-de-admin@ejemplo.com

# ─── Push Notifications (sistema automatizado) ─────────────────────────────────
# Secreto para que Supabase Webhooks / Cron Jobs puedan llamar a /api/push/send.
# Genera uno con: openssl rand -hex 32
PUSH_SEND_SECRET=
